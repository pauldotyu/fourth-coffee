let window = 30m;
let routes = dependencies
| where timestamp > ago(window) and name == "concierge.route"
| where tostring(customDimensions["concierge.operations_intent"]) == "specials"
| project operation_Id, RouteSpan = id, duration, timestamp;
let router = dependencies
| where timestamp > ago(window) and name == "invoke_agent ConciergeRouter"
| project operation_Id, RouteSpan = operation_ParentId, AgentSpan = id;
let calls = dependencies
| where timestamp > ago(window) and name startswith "chat "
| summarize model_calls = count() by operation_Id, AgentSpan = operation_ParentId;
routes
| join kind=leftouter router on operation_Id, RouteSpan
| join kind=leftouter calls on operation_Id, AgentSpan
| summarize model_calls = sum(coalesce(model_calls, 0)) by operation_Id, RouteSpan, duration, timestamp
| summarize turns = count(), calls_per_turn = round(avg(model_calls), 1), p50_ms = round(percentile(duration, 50)), p95_ms = round(percentile(duration, 95)) by bin(timestamp, 2m)
| order by timestamp asc
